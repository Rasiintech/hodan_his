 "html": "<style>\r\n    /* Force PDF engine to keep content together and remove ghost pages */\r\n    .print-format {\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n    @media print {\r\n        html, body {\r\n            height: 99%; /* Prevents a tiny overflow creating a second page */\r\n            margin: 0 !important; \r\n            padding: 0 !important;\r\n        }\r\n        .print-format {\r\n            page-break-inside: avoid !important;\r\n        }\r\n    }\r\n    /* Standardizes the look of the table without external classes */\r\n    .result-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 10px;\r\n    }\r\n    .result-table th, .result-table td {\r\n        border: 1px solid #ddd;\r\n        padding: 5px;\r\n        text-align: left;\r\n    }\r\n</style>\r\n\r\n<div style=\"font-family: Arial, sans-serif; font-size: 11px; line-height: 1.3; width: 650px; margin: 0 auto;\">\r\n\r\n    <h2 style=\"text-align: center; font-size: 16px; margin: 5px 0; font-weight: bold;\">\r\n       Hodan Hospital\r\n    </h2>\r\n    <h2 style=\"text-align: center; font-size: 18px; margin: 5px 0; font-weight: bold;\">\r\n        Department of Laboratory Medicine\r\n    </h2>\r\n    \r\n    {% set p = frappe.get_doc(\"Patient\", doc.patient) if doc.patient else None %}\r\n    {% set sex = p.sex if p else (doc.patient_sex or \"\") %}\r\n    {% set age = (p.p_age if p else \"\") %}\r\n    {% set age_type = (p.age_type if p else \"\") %}\r\n    {% set patient_name = p.patient_name if p else \"\" %}\r\n\r\n<h3>Patient Information</h3>\r\n    <div style=\"display: flex; justify-content: space-between; border: 1px solid black; padding: 4px; margin-bottom: 5px;\">\r\n        \r\n        <div style=\"width: 48%;\">\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Patient Name:</span>\r\n                <span>{{ patient_name }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Patient ID:</span>\r\n                <span>{{ doc.patient }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Age/Sex:</span>\r\n                <span>{{ age }} - {{ age_type }} / {{ frappe.db.get_value(\"Patient\", doc.patient, \"sex\") or \"\" }}</span>\r\n            </div>\r\n            <div style=\"display: flex;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Tel No:</span>\r\n                <span>{{ frappe.db.get_value(\"Patient\", doc.patient, \"mobile_no\") or \"\" }}</span>\r\n            </div>\r\n        </div>\r\n\r\n        <div style=\"width: 48%;\">\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Lab Ref No:</span>\r\n                <span>{{ doc.lab_ref or \"\" }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Date:</span>\r\n                <span>{{ doc.date }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Report Time:</span>\r\n                <span>{{ frappe.format(doc.time, \"Time\") or \"\" }}</span>\r\n            </div>\r\n            <div style=\"display: flex;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Doctor:</span>\r\n                <span>{{ doc.practitioner }}</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <h3 style=\"margin: 5px 0; font-size: 14px; font-weight: bold; \">CBC Report</h3>\r\n\r\n    <table class=\"\" style=\"width: 100%\">\r\n        <thead style=\"border: 1px solid black; font-weight: bold; font-size: 14px; width: 100%; background: #fef4e2; color: black\">\r\n            <tr>\r\n                <th >Test Name</th>\r\n                <th >Result</th>\r\n                <th >N Range</th>\r\n                <th >UOM</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody style=\"width: 100%\">\r\n            {% for row in doc.normal_test_items %}\r\n                {% set test_name = row.lab_test_name | lower %}\r\n                {% set template_name = doc.template | lower %}\r\n                {% if \"cbc\" in test_name or \"haemogram\" in test_name or \"platelet\" in test_name or \"cbc\" in template_name %}\r\n                <tr>\r\n                    <td>{{ row.lab_test_name or row.lab_test_event }}</td>\r\n                    <td style=\"font-weight: bold;\">{{ row.result_value }}</td>\r\n                    <td>{{ row.normal_range or \"\" }}</td>\r\n                    <td>{{ row.lab_test_uom or \"\" }}</td>\r\n                </tr>\r\n                {% endif %}\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <div style=\"text-align: center; font-size: 10px; border-top: 1px solid #eee;\">\r\n        <strong>------- End Of Test Report -------</strong>\r\n    </div>\r\n\r\n</div>",
