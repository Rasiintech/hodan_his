 "html": "<div style=\"width: 650px; margin: 0 auto;\">\n    <div>{{ letter_head }}</div>\n    \n    <div class=\"row\">\n        <div class=\"col-xs-12\">\n            <h1 style=\"text-align: center; font-size: 18px; margin-bottom: 10px; font-weight: bold\">Department of Laboratory Medicine</h1>\n                {% set p = frappe.get_doc(\"Patient\", doc.patient) if doc.patient else None %}\n                {% set sex = p.sex if p else (doc.patient_sex or \"\") %}\n                {% set age = (p.p_age if p else \"\") %}\n                {% set age_type = (p.age_type if p else \"\") %}\n                {% set patient_name = p.patient_name if p else \"\" %}\n            \n            <h3>Patient Information</h3>\n            <div style=\"width: 100%; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 1.6; display: flex; justify-content: space-between; align-items: flex-start; border: 1px solid black; padding: 10px; margin-bottom: 0px;\">\n                <div style=\"width: 48%;\">\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Patient Name:</div>\n                        <div>{{ patient_name }}</div>\n                    </div>\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Patient ID:</div>\n                        <div>{{ doc.patient }}</div>\n                    </div>\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Age:</div>\n                        <div>{{ age }} - {{ age_type }} </div>\n                    </div>\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Sex:</div>\n                        <div>{{ frappe.db.get_value(\"Patient\", doc.patient, \"sex\") or \"\" }}</div>\n                    </div>\n                </div>\n                <div style=\"width: 48%;\">\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Lab Ref No:</div>\n                        <div>{{ doc.lab_ref or \"\" }}</div>\n                    </div>\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Report Date:</div>\n                        <div>{{ doc.date }}</div>\n                    </div>\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Report Time:</div>\n                        <div>{{ doc.time }}</div>\n                    </div>\n                    <div style=\"display: flex; gap: 10px; margin-bottom: 4px;\">\n                        <div style=\"font-weight: bold;\">Ref Doctor:</div>\n                        <div>{{ doc.practitioner }}</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <h3 style=\"text-align: center\">Lab  Report</h3>\n    <!--<table class=\"table table-bordered table-condensed\">-->\n    <table class=\"\" style=\"width: 100%\">\n        <thead style=\"border: 1px solid black; font-weight: bold; font-size: 14px; width: 100%; background: #fef4e2; color: black\">\n            <tr>\n                <th >Test Name</th>\n                <th >Result</th>\n                <th >N Range</th>\n                <th >UOM</th>\n            </tr>\n        </thead>\n        <!--<tbody style=\"width: 100%\">-->\n        <!--    {% set labs = frappe.get_all(\"Lab Result\", filters={\"patient\": doc.patient, \"date\": doc.date, \"docstatus\": [\"<\", 2]}, fields=[\"name\", \"template\"]) %}-->\n            \n        <!--    {% for lab in labs %}-->\n        <!--        {% set t_name = (lab.template or \"\") | lower %}-->\n        <!--        {% if \"cbc\" not in t_name and \"urine routine\" not in t_name and \"stool general\" not in t_name %}-->\n                    \n        <!--            {% set lab_doc = frappe.get_doc(\"Lab Result\", lab.name) %}-->\n        <!--            {% for row in lab_doc.normal_test_items %}-->\n        <!--                {% set test_name = (row.lab_test_name or row.lab_test_event or \"\") | lower %}-->\n        <!--                {% if \"cbc\" not in test_name and \"urine routine\" not in test_name and \"stool general\" not in test_name %}-->\n\n        <!--                    {% if row.result_value == \"\" or row.result_value is none %}-->\n        <!--                            <tr>-->\n        <!--                                  <td>-->\n        <!--                                  <p style=\"font-weight: bold\">No result. print when all the result have result value!</p>-->\n        <!--                                  </td>  -->\n        <!--                            </tr>-->\n        <!--                    {% else %}-->\n        <!--                            <tr>-->\n        <!--                                <td style=\"font-size: 14px;\">{{ row.lab_test_name or row.lab_test_event }}</td>-->\n        <!--                                <td style=\"font-weight: bold; font-size: 14px;\">{{ row.result_value }}</td>-->\n        <!--                                <td style=\"font-size: 14px;\">{{ row.normal_range or \"\" }}</td>-->\n        <!--                                <td style=\"font-size: 14px;\">{{ row.lab_test_uom or \"\" }}</td>-->\n        <!--                            </tr>-->\n        <!--                    {% endif %}-->\n        <!--                {% endif %}-->\n        <!--            {% endfor %}-->\n\n        <!--        {% endif %}-->\n        <!--    {% endfor %}-->\n        <!--</tbody>-->\n        <tbody style=\"width: 100%\">\n    {% set ns = namespace(has_result=false) %}\n\n    {% set labs = frappe.get_all(\"Lab Result\", filters={\"patient\": doc.patient, \"date\": doc.date, \"docstatus\": [\"<\", 2]}, fields=[\"name\", \"template\"]) %}\n    \n    {% for lab in labs %}\n        {% set t_name = (lab.template or \"\") | lower %}\n        {% if \"cbc\" not in t_name and \"urine routine\" not in t_name and \"stool general\" not in t_name %}\n            \n            {% set lab_doc = frappe.get_doc(\"Lab Result\", lab.name) %}\n            \n            {% for row in lab_doc.normal_test_items %}\n                {% set test_name = (row.lab_test_name or row.lab_test_event or \"\") | lower %}\n                \n                {% if \"cbc\" not in test_name and \"urine routine\" not in test_name and \"stool general\" not in test_name %}\n                    \n                    {% if row.result_value %}\n                        {% set ns.has_result = true %}\n                        <tr>\n                            <td style=\"font-size: 14px;\">{{ row.lab_test_name or row.lab_test_event }}</td>\n                            <td style=\"font-weight: bold; font-size: 14px;\">{{ row.result_value }}</td>\n                            <td style=\"font-size: 14px;\">{{ row.normal_range or \"\" }}</td>\n                            <td style=\"font-size: 14px;\">{{ row.lab_test_uom or \"\" }}</td>\n                        </tr>\n                    {% endif %}\n\n                {% endif %}\n            {% endfor %}\n\n        {% endif %}\n    {% endfor %}\n\n    {% if not ns.has_result %}\n    <tr>\n        <td colspan=\"4\" style=\"text-align: center; font-weight: bold;\">\n            No result available\n        </td>\n    </tr>\n    {% endif %}\n</tbody>\n    </table>\n    <h1 style=\"text-align: center; font-size: 14px; margin-top: 20px\">-------End Of Test Report-------</h1>\n</div>",
