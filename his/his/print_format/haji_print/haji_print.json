 "html": "<div class=\"custom-letter-head\" style=\"max-height: 150px; overflow: hidden; margin-bottom: 20px;\">\r\n    {{ letter_head }}\r\n</div>\r\n\r\n<div class=\"header-meta\" style=\"margin-top: 10px; margin-bottom: 20px; border-bottom: 1px solid #ccc; padding-bottom: 10px;\">\r\n    <table style=\"width: 100%; border: none;\">\r\n        <tr>\r\n            <td style=\"text-align: left; border: none;\"><strong>Ref:</strong> {{ doc.name }}</td>\r\n            <td style=\"text-align: right; border: none;\"><strong>Date:</strong> {{ doc.get_formatted(\"date\") or frappe.utils.nowdate() }}</td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n\r\n<div style=\"margin-bottom: 20px; padding: 10px; border: 1px solid #eee; background-color: #fafafa;\">\r\n    <table style=\"width: 100%; border: none; font-size: 14px;\">\r\n        <tr>\r\n            <td style=\"width: 15%; border: none;\"><strong>Patient Name:</strong></td>\r\n            <td style=\"width: 45%; border: none;\">{{ doc.patient_name or doc.patient }}</td>\r\n            <td style=\"width: 10%; border: none;\"><strong>Age/Sex:</strong></td>\r\n            <td style=\"width: 30%; border: none;\">{{ doc.age or '' }} / {{ doc.sex or '' }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"border: none;\"><strong>ID/Passport:</strong></td>\r\n            <td style=\"border: none;\">{{ doc.passport or '' }}</td>\r\n            <td style=\"border: none;\"><strong>Contact:</strong></td>\r\n            <td style=\"border: none;\">{{doc.mobile or ''}} / {{doc.emergency_number}}</td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n\r\n<style>\r\n    /* This targets any image inside the letterhead to make sure it doesn't overflow */\r\n    .custom-letter-head img {\r\n        max-width: 100%;\r\n        max-height: 100px; /* Adjust this value to your preferred height */\r\n        object-fit: contain;\r\n    }\r\n    .screening-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        font-size: 14px;\r\n        margin-bottom: 20px;\r\n    }\r\n    .screening-table th {\r\n        background-color: #f0f0f0;\r\n        border: 1px solid #000;\r\n        padding: 8px;\r\n        text-align: center;\r\n    }\r\n    .screening-table td {\r\n        border: 1px solid #000;\r\n        padding: 8px;\r\n        vertical-align: middle;\r\n    }\r\n    .check-box {\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n    }\r\n    .notes-section {\r\n        font-size: 14px;\r\n        margin-top: 20px;\r\n    }\r\n    .notes-label {\r\n        font-weight: bold;\r\n        margin-bottom: 5px;\r\n        display: block;\r\n    }\r\n    .notes-content {\r\n        border-bottom: 1px solid #ccc;\r\n        padding: 5px 0;\r\n        min-height: 20px;\r\n    }\r\n</style>\r\n\r\n<table class=\"screening-table\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width: 70%; text-align: left;\">Medical Assessment Question</th>\r\n            <th style=\"width: 15%;\">Yes</th>\r\n            <th style=\"width: 15%;\">No</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% set questions = [\r\n            (\"1. Do you suffer from epilepsy or from sudden attacks of loss of consciousness or giddiness from any cause?\", \"yes1\", \"no1\"),\r\n            (\"2. Are you suffering from stroke or paralysis?\", \"yes2\", \"no2\"),\r\n            (\"3. Are you suffering any mental disease or take medication ?\", \"yes3\", \"no3\"),\r\n            (\"4. Have you ever been diagnosed with Tuberculosis (TB)?\", \"yes5\", \"no5\"),\r\n            (\"5. Hypertension (BP)\", \"yes6\", \"no6\"),\r\n            (\"6. Diabetes Mellitus\", \"yes7\", \"no7\"),\r\n            (\"7. COPD (Asthma/Bronchitis/Emphysema etc.)\", \"yes8\", \"no8\"),\r\n            (\"8. Heart related illness\", \"yess9\", \"noo9\"),\r\n            (\"9. Liver disease\", \"yes10\", \"no10\"),\r\n            (\"10. Kidney disease\", \"yes11\", \"no11\"),\r\n            (\"11. Cancer\", \"yes12\", \"no12\"),\r\n            (\"12. Bleeding Disorder\", \"yes13\", \"no13\"),\r\n            (\"13. Pregnant\", \"yes14\", \"no14\"),\r\n        ] %}\r\n\r\n        {% for q_text, yes_field, no_field in questions %}\r\n        <tr>\r\n            <td style=\"text-align: left;\">{{ q_text }}</td>\r\n            <td class=\"check-box\">{{ \"\u2611\" if doc.get(yes_field) else \"\u2610\" }}</td>\r\n            <td class=\"check-box\">{{ \"\u2611\" if doc.get(no_field) else \"\u2610\" }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n<div class=\"notes-section\">\r\n    {# Display \"If Pregnant\" section only if if_yes has a value #}\r\n    {% if doc.if_yes %}\r\n    <div style=\"margin-bottom: 15px;\">\r\n        <span class=\"notes-label\">If Pregnant, How Many Weeks?:</span>\r\n        <div class=\"notes-content\">{{ doc.if_yes }}</div>\r\n    </div>\r\n    {% endif %}\r\n    \r\n    {# Display \"Any Other\" section only if txt has a value #}\r\n    {% if doc.txt %}\r\n    <div>\r\n        <span class=\"notes-label\">Any Other (Specify):</span>\r\n        <div style=\"border: 1px solid #ccc; padding: 10px; min-height: 60px; border-radius: 4px;\">\r\n            {{ doc.txt }}\r\n        </div>\r\n    </div>\r\n    {% endif %}\r\n</div>",
