 "html": "<div style=\"width: 650px; margin: 0 auto;\">\r\n      <div>{{ letter_head }}</div>\r\n    <div class=\"row\">\r\n        <div class=\"col-xs-12\">\r\n                  <h1 style=\"text-align: center; font-size: 18px; margin-bottom: 10px; font-weight: bold\">Department of Laboratory Medicine</h1>\r\n    {% set p = frappe.get_doc(\"Patient\", doc.patient) if doc.patient else None %}\r\n    {% set sex = p.sex if p else (doc.patient_sex or \"\") %}\r\n    {% set age = (p.p_age if p else \"\") %}\r\n    {% set age_type = (p.age_type if p else \"\") %}\r\n    {% set patient_name = p.patient_name if p else \"\" %}\r\n <h3>Patient Information</h3>\r\n<div style=\"display: flex; justify-content: space-between; border: 1px solid black; padding: 4px; margin-bottom: 5px;\">\r\n        \r\n        <div style=\"width: 48%;\">\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Patient Name:</span>\r\n                <span>{{ patient_name }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Patient ID:</span>\r\n                <span>{{ doc.patient }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Age/Sex:</span>\r\n                <span>{{ age }} - {{ age_type }} / {{ frappe.db.get_value(\"Patient\", doc.patient, \"sex\") or \"\" }}</span>\r\n            </div>\r\n            <div style=\"display: flex;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Tel No:</span>\r\n                <span>{{ frappe.db.get_value(\"Patient\", doc.patient, \"mobile_no\") or \"\" }}</span>\r\n            </div>\r\n        </div>\r\n\r\n        <div style=\"width: 48%;\">\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Lab Ref No:</span>\r\n                <span>{{ doc.lab_ref or \"\" }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Date:</span>\r\n                <span>{{ doc.date }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-bottom: 2px;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Report Time:</span>\r\n                <span>{{ frappe.format(doc.time, \"Time\") or \"\" }}</span>\r\n            </div>\r\n            <div style=\"display: flex;\">\r\n                <span style=\"font-weight: bold; width: 90px;\">Doctor:</span>\r\n                <span>{{ doc.practitioner }}</span>\r\n            </div>\r\n        </div>\r\n    </div>\r\n        </div>\r\n    </div>\r\n\r\n        <h3>Body Fluid Report</h3>\r\n    <!--<table class=\"table table-bordered table-condensed\">-->\r\n    <table class=\"\" style=\"width: 100%\">\r\n        <thead style=\"border: 1px solid black; font-weight: bold; font-size: 14px; width: 100%; background: #fef4e2; color: black\">\r\n            <tr>\r\n                <th>Test Name</th>\r\n                <th>Result</th>\r\n                <th>N Range</th>\r\n                <!--<th style=\"width: 20%\">UOM</th>-->\r\n            </tr>\r\n        </thead>\r\n        <tbody style=\"width: 100%\">\r\n            {% for row in doc.normal_test_items %}\r\n                {% set test_name = row.lab_test_name | lower %}\r\n                {% set template_name = doc.template | lower %}\r\n                \r\n                {% if \"Body Fluid\" in test_name or \"Body Fluid\" in template_name %}\r\n                <tr>\r\n                    <td>{{ row.lab_test_name or row.lab_test_event }}</td>\r\n                    <td style=\"font-weight: bold;\">{{ row.result_value }}</td>\r\n                    <td>{{ row.normal_range or \"\" }}</td>\r\n                    <!--<td>{{ row.lab_test_uom or \"\" }}</td>-->\r\n                </tr>\r\n                {% endif %}\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n    \r\n        <h1 style=\"text-align: center; font-size: 14px; margin-top: 20px\">-------End Of Test Report-------</h1>\r\n</div>",
